NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GHL_PRIVATE_INTEGRATION_TOKEN=pit_your_private_integration_token
GHL_LOCATION_ID=your_subaccount_location_id
# Dominio de la app de HighLevel con marca blanca. El valor por defecto es app.iaorbita.com.
GHL_APP_BASE_URL=https://app.iaorbita.com
# Opcionales: la app descubre el pipeline "Mayoristas" y sus etapas por nombre.
# Define IDs para evitar depender de los nombres configurados en HighLevel.
GHL_WHOLESALE_PIPELINE_ID=
GHL_STAGE_ORDER_PLACED_ID=
GHL_STAGE_PREPARING_ID=
GHL_STAGE_DISPATCHED_ID=
GHL_STAGE_HELP_ID=
GHL_STAGE_PAYMENT_PENDING_ID=
GHL_STAGE_PAID_ID=
# Opcionales: la app descubre el pipeline "Minoristas" y sus etapas por nombre.
GHL_RETAIL_PIPELINE_ID=
GHL_RETAIL_STAGE_ORDER_PLACED_ID=
GHL_RETAIL_STAGE_PREPARING_ID=
GHL_RETAIL_STAGE_DISPATCHED_ID=
GHL_RETAIL_STAGE_HELP_ID=
GHL_RETAIL_STAGE_PAYMENT_PENDING_ID=
GHL_RETAIL_STAGE_PAID_ID=
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
ORDERS_INGEST_SECRET=replace_with_a_long_random_secret
RETAIL_ORDERS_INGEST_SECRET=replace_with_a_distinct_long_random_secret
